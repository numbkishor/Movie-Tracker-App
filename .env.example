# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Supabase project URL and anon/public key.
# The anon key is designed to be public and is safe in the browser; every table
# it can reach is protected by RLS (see supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# TMDB v3 API key. Server-side only — deliberately NOT prefixed NEXT_PUBLIC_,
# so it never reaches the browser bundle. All TMDB calls go through /api/tmdb/*.
TMDB_API_KEY=

# The service-role key is intentionally absent. Nothing in this app needs to
# bypass RLS. If that ever changes, it belongs in a server-only variable and
# must never be referenced from a client component.
